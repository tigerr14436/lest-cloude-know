
# PostgreSQL - mỗi người tự cấu hình database của mình
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/devtask_db

# JWT - tự tạo chuỗi bí mật riêng, tối thiểu 32 ký tự
JWT_SECRET_KEY=replace_with_your_own_random_secret_key_at_least_32_chars

# OTP - khóa riêng để mã hóa mã xác minh email
OTP_PEPPER=replace_with_your_own_random_otp_pepper_at_least_32_chars

# Gmail SMTP - dùng để gửi mã xác minh tài khoản
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# Tắt log SQL khi chạy bình thường
DATABASE_ECHO=false
